<?xml version="1.0" encoding="utf-8"?>
<!-- App backup is disabled in the manifest (`allowBackup="false"`) so this
     file is informational only on API 30 and below. We keep it tight in
     case backup ever gets re-enabled. -->
<full-backup-content>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="database"   path="."/>
    <exclude domain="file"       path="encrypted/"/>
</full-backup-content>
