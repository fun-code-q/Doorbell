<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 12+ Splash Screen API override.
         Honoured automatically by the system on every cold start.
         The icon scales itself to the platform's 240dp circle; the
         background is the surrounding solid colour. -->
    <style name="Theme.QRVault.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.QRVault</item>
    </style>

</resources>
