# =============================================================================
# QR Doorbell — runtime configuration template.
#
# This project has no Node server, so these values are NOT read at runtime by
# the application. They are referenced by:
#   * scripts/* build helpers (sourced on the deploy runner)
#   * GitHub Actions secrets that mirror these names
#   * `node` snippets in deploy.yml that build runtime-config.js
# Copy this file to `.env`, fill in real values, and never commit `.env`.
# =============================================================================

# ---- Public (browser-visible, RLS-gated) ----
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<rotated-anon-jwt>
VERIFY_RING_URL=https://<your-project-ref>.functions.supabase.co/verify-ring
TURNSTILE_SITE_KEY=<cloudflare-turnstile-site-key>
EXPECTED_ORIGIN=https://your-domain.example

# ---- Server-side only — NEVER expose to the browser ----
# Set these as Edge Function secrets in the Supabase dashboard. Listed here
# just so a fresh contributor knows what the function expects.
SUPABASE_SERVICE_ROLE_KEY=server-side-only
PUSH_WEBHOOK_SECRET=server-side-only            # openssl rand -hex 32
FIREBASE_SERVICE_ACCOUNT_JSON=server-side-only  # full JSON, rotated per USER_ACTIONS step 1
FIREBASE_PROJECT_ID=qr-vault-14abb
TURNSTILE_SECRET_KEY=server-side-only
IP_HASH_PEPPER=server-side-only                 # openssl rand -hex 32; rotate every 90d
ALLOWED_ORIGINS=https://your-domain.example,http://localhost:3000

# ---- QRVault native (Android) ----
# These values land in QRVault/local.properties on developer machines and
# in the QRVault Android CI workflow as `secrets.SUPABASE_URL`,
# `secrets.SUPABASE_ANON_KEY`, and `secrets.GUEST_BASE_URL`.
GUEST_BASE_URL=https://your-domain.example/

# ---- Release signing (CI only) ----
ANDROID_KEYSTORE_B64=server-side-only
ANDROID_KEYSTORE_PASSWORD=server-side-only
ANDROID_KEY_ALIAS=server-side-only
ANDROID_KEY_PASSWORD=server-side-only
