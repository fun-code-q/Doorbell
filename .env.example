# Runtime reference values for QR Doorbell
# This project is static; these keys map to window.__QR_CONFIG or public/config.js values.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional legacy alias (same value as SUPABASE_ANON_KEY)
SUPABASE_KEY=your-anon-key

# Encryption passphrase used by client-side crypto module
ENCRYPTION_PASSPHRASE=generate-a-random-32-plus-char-string

# App metadata
APP_NAME=QR Doorbell
APP_URL=https://your-domain.com

# Never expose this in frontend runtime config.
# SERVICE ROLE keys are only for trusted server-side code (Edge Functions/API backend).
SUPABASE_SERVICE_ROLE_KEY=server-side-only
